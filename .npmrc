# pnpm v10 runs a dependency-status check before every `pnpm run <script>` and
# aborts the script if any dependency has an unapproved/ignored build script
# (ERR_PNPM_IGNORED_BUILDS). That gate blocks `pnpm electron:dev` even though the
# only build script we actually need (electron's binary download) has already run.
# Disable the pre-run check so scripts launch regardless; approvals are still
# governed by the pnpm.onlyBuiltDependencies / ignoredBuiltDependencies lists in
# package.json.
verify-deps-before-run=false
